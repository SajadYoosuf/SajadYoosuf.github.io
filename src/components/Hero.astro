---
// src/components/Hero.astro
---
<header class="hero" id="top">
  <div class="wrap hero-grid">
    <div>
      <span class="eyebrow">Product Engineer · Calicut, India</span>
      <h1>I turn user problems into <em>production software.</em></h1>
      <p class="lede">
        Software Product Engineer at <strong>Ogera Ventures Pvt. Ltd.</strong>, where I build
        the products the business runs on — an in-house sales management system (CRM) and an
        AI chatbot for customer communication. I own products end-to-end: understanding the
        user, designing the system, shipping to production, and measuring what happened next.
      </p>
      <div class="hero-ctas">
        <a class="btn btn-primary" href="#work">See the work</a>
        <a class="btn btn-ghost" href="https://github.com/SajadYoosuf" target="_blank" rel="noopener">GitHub ↗</a>
      </div>
    </div>

    <aside class="status-card" aria-label="Live GitHub status">
      <div class="status-head">
        <img id="gh-avatar" src="https://avatars.githubusercontent.com/u/174928297?v=4" alt="Sajad Yoosuf" />
        <div>
          <div class="status-name">@SajadYoosuf</div>
          <div class="status-sub" id="gh-lastpush">syncing…</div>
        </div>
        <span class="live-chip"><span class="live-dot"></span>LIVE</span>
      </div>
      <div class="stat-row">
        <div class="stat-cell"><div class="stat-num" id="s-repos">77</div><div class="stat-label">Repositories</div></div>
        <div class="stat-cell"><div class="stat-num" id="s-langs">6+</div><div class="stat-label">Languages</div></div>
        <div class="stat-cell"><div class="stat-num" id="s-stars">—</div><div class="stat-label">Stars earned</div></div>
        <div class="stat-cell"><div class="stat-num" id="s-followers">10</div><div class="stat-label">Followers</div></div>
      </div>
      <div class="pulse-block">
        <div class="pulse-label"><span>Push activity</span><span id="pulse-range">recent weeks</span></div>
        <div class="pulse-strip" id="pulse" aria-label="Recent GitHub push activity"></div>
      </div>
    </aside>
  </div>
</header>
