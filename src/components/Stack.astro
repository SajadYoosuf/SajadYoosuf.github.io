---
// src/components/Stack.astro
---
<section id="stack">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow">Stack</span>
      <h2>Tools chosen for shipping, not for the résumé</h2>
    </div>
    <div class="stack-grid">
      <div class="stack-col reveal">
        <h3>Product surfaces</h3>
        <div class="chip-row">
          <span class="chip">Flutter</span><span class="chip">Dart</span><span class="chip">React</span>
          <span class="chip">JavaScript</span><span class="chip">HTML/CSS</span>
        </div>
      </div>
      <div class="stack-col reveal">
        <h3>Backend &amp; data</h3>
        <div class="chip-row">
          <span class="chip">Python</span><span class="chip">FastAPI</span><span class="chip">Django</span>
          <span class="chip">PostgreSQL</span><span class="chip">MySQL</span><span class="chip">MongoDB</span>
        </div>
      </div>
      <div class="stack-col reveal">
        <h3>AI &amp; craft</h3>
        <div class="chip-row">
          <span class="chip">Generative AI</span><span class="chip">LLM APIs</span><span class="chip">Java</span>
          <span class="chip">C</span><span class="chip">Git &amp; GitHub</span><span class="chip">System design</span>
        </div>
      </div>
    </div>
  </div>
</section>
