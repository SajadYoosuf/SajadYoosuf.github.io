---
// src/components/SkillsMatrix.astro
import { skillsMatrix } from '../data/portfolioData';
import { Layers, Database, Cpu, HardDrive, ClipboardList, PenTool } from 'lucide-react';

const icons = {
  'Frontend': Layers,
  'Backend': Cpu,
  'Data & DB': Database,
  'Infra & DevOps': HardDrive,
  'Product & Hybrid': ClipboardList,
  'Design & UX': PenTool
};
---

<section id="skills" class="py-24 border-t border-border-faint relative">
  <div class="max-w-6xl mx-auto px-6">
    {/* Section Title */}
    <div class="mb-16 space-y-3">
      <span class="text-xs font-bold tracking-widest text-accent uppercase block">
        ARSENAL
      </span>
      <h2 class="text-3xl md:text-4xl font-semibold tracking-tight text-text-primary">
        Skills & Capabilities
      </h2>
      <p class="text-sm md:text-base text-text-secondary max-w-xl">
        Comfortable across the full engineering stack. I focus on deploying highly performant systems and products that translate directly to business outcomes.
      </p>
    </div>

    {/* Skills Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {skillsMatrix.map((item) => {
        const IconComponent = icons[item.category as keyof typeof icons] || Layers;
        return (
          <div class="group bg-surface border border-border-faint hover:border-neutral-300 hover:-translate-y-1 hover:shadow-xs rounded-xl p-6 transition-all duration-300">
            {/* Category Header */}
            <div class="flex items-center gap-3 mb-5 pb-3 border-b border-border-faint group-hover:border-neutral-200/80 transition-colors">
              <div class="p-2 rounded-lg bg-neutral-50 text-text-secondary group-hover:bg-accent/5 group-hover:text-accent transition-colors duration-300">
                <IconComponent className="w-5 h-5" />
              </div>
              <h3 class="text-base font-semibold text-text-primary tracking-tight">
                {item.category}
              </h3>
            </div>

            {/* Badges Container */}
            <div class="flex flex-wrap gap-2">
              {item.skills.map((skill) => (
                <span 
                  class="inline-block px-3 py-1.5 text-xs font-medium rounded-full bg-neutral-100/70 border border-neutral-200/40 text-neutral-800 transition-all duration-200 hover:scale-105 hover:bg-neutral-200/80 hover:text-text-primary cursor-default shadow-3xs"
                >
                  {skill}
                </span>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
